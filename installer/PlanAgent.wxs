<?xml version="1.0" encoding="UTF-8"?>
<!-- FR #154: Plan agent files only. Platform x64; Feature is required or msiexec installs nothing. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Plan Agent"
      Manufacturer="SimonBarnett"
      Version="$(var.ProductVersion)"
      UpgradeCode="8F3C2A10-4B6E-4D11-9C2A-0E5F1A7B1540"
      Scope="perMachine"
      Platform="x64">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Plan Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Plan Agent">
        <Directory Id="PLANAGENTDIR" Name="plan-agent" />
      </Directory>
    </StandardDirectory>
    <Feature Id="PlanAgent" Title="Plan Agent" Level="1">
      <Component Directory="INSTALLFOLDER" Guid="8F3C2A10-4B6E-4D11-9C2A-0E5F1A7B1541">
        <File Id="PlanAgentExe" Source="$(var.PlanExe)" KeyPath="yes" />
      </Component>
      <Files Directory="PLANAGENTDIR" Include="$(var.PlanRoot)\**" />
    </Feature>
  </Package>
</Wix>
